{:paths ["src"]
 :deps {org.apache.commons/commons-math3 {:mvn/version "3.6.1"}
        org.clojure/clojure {:mvn/version "1.12.1"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.replikativ/foerster {:mvn/version "0.1.137"}
        org.replikativ/raster {:mvn/version "0.2.1720"}
        org.replikativ/foerster-raster {:mvn/version "0.1.14"}}
 :aliases
 {:jvm {:jvm-opts ["--enable-native-access=ALL-UNNAMED" "--add-modules=jdk.incubator.vector"
                   "-Xss4m" "-Xmx512m" "-XX:MaxMetaspaceSize=384m"
                   "-XX:ActiveProcessorCount=2"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}
                 io.github.borkdude/gh-release-artifact {:git/sha "b946558225a7839f6a0f644834e838e190dc2262"}
                 babashka/babashka.curl {:mvn/version "0.1.2"}
                 babashka/fs {:mvn/version "0.3.17"}
                 cheshire/cheshire {:mvn/version "5.11.0"}}
          :ns-default build}
  :local {:override-deps {org.replikativ/foerster-raster {:local/root "../foerster-raster"}}}
  :test {:extra-paths ["test"] :main-opts ["-m" "org.replikativ.marketing.test-runner"]}
  :examples {:extra-paths ["examples"]}
  ;; Reproduction of the published Kettle & Pine study (study/README.md).
  :study {:extra-paths ["study" "examples"]}
  :repl {:extra-paths ["test" "examples" "study"]}
  :ffix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
         :main-opts ["-m" "cljfmt.main" "fix" "build.clj" "src" "test" "examples" "study"]}
  :format {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
           :main-opts ["-m" "cljfmt.main" "check" "build.clj" "src" "test" "examples" "study"]}}}
